# ==========================================
# DrawMate SaaS Environment Configuration
# ==========================================

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS and reset link generation)
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Leave blank in development to automatically use the embedded MongoMemoryServer
MONGODB_URI=mongodb://localhost:27017/drawmate

# Cryptographic Secrets (generate 64-char random hex in production)
JWT_ACCESS_SECRET=your-development-access-secret-replace-in-production-38917294871239
JWT_REFRESH_SECRET=your-development-refresh-secret-replace-in-production-98172381273918
COOKIE_SECRET=your-development-cookie-secret-replace-in-production-12345

# Token Lifespans
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers & ML Inference Service
# Groq High-Speed LLM API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq

# Google Gemini API key (optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# Local FastAPI Sketch Recognizer ML Microservice URL
SKETCH_RECOGNIZER_URL=http://localhost:8000

# ==========================================
# SMTP Email Dispatch Configuration
# ==========================================
# In development: If SMTP credentials are unset, the server falls back to simulation mode
# (emails with OTPs and tokens are rendered directly to the server logger/console).
# In production: Full credentials (HOST, USER, PASS) are required for live email dispatch
# (used for email verification, password resets, and security login notifications).

# SMTP Outgoing Server Hostname
# Required for live email delivery in production; optional in development.
# Examples: smtp.gmail.com, smtp.sendgrid.net, smtp.mailtrap.io, email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.mailtrap.io

# SMTP Port
# Optional. Default: 587 (Standard submission with STARTTLS).
# Common values: 587 (STARTTLS), 465 (Direct SSL/TLS), or 2525 (Alternative).
SMTP_PORT=587

# SMTP Secure Connection Mode
# Optional. Default: false for port 587 (STARTTLS upgraded automatically).
# Set to 'true' if connecting directly over SSL/TLS (e.g. port 465).
# Note: In env.ts, if SMTP_PORT is 465, secure mode is automatically activated.
SMTP_SECURE=false

# SMTP Authentication Username
# Required for live email delivery in production.
# Examples: your-username@gmail.com, apikey (for SendGrid), or Mailtrap username
SMTP_USER=your-smtp-username

# SMTP Authentication Password / App-Specific Password / API Key
# Required for live email delivery in production.
# Note: env.ts supports both SMTP_PASS and SMTP_PASSWORD aliases.
# NEVER commit real passwords or API keys to version control!
SMTP_PASS=your-smtp-password-or-api-key
# SMTP_PASSWORD=your-smtp-password-or-api-key

# Outgoing "From" Address & Display Name
# Optional. Default: 'DrawMate <no-reply@drawmate.app>'
# Format: 'Display Name <email@domain.com>' or plain email address
SMTP_FROM="DrawMate <no-reply@drawmate.app>"

